{
  "name": "derivatives-101",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "oxfmt src vite.config.ts && prettier --write \"*.css\"",
    "format:check": "oxfmt --check src vite.config.ts && prettier --check \"*.css\"",
    "lint": "oxlint src vite.config.ts && npm run lint:css",
    "lint:fix": "oxlint --fix src vite.config.ts && npm run lint:css:fix",
    "lint:css": "stylelint \"*.css\"",
    "lint:css:fix": "stylelint \"*.css\" --fix",
    "check": "npm run format:check && npm run lint && tsc --noEmit && vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@stylistic/stylelint-config": "^5.0.0",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
